# Postgres 연결 문자열 (Neon, Supabase 등 무료 클라우드 DB)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Cloudflare R2 (사진/동영상 저장소, S3 호환 API)
# 1) Cloudflare 대시보드 -> R2 -> 버킷 생성 (예: class-project-board)
# 2) 버킷 설정 -> "Public access"에서 공개 접근을 켜면 r2.dev 공개 URL이 생깁니다.
#    (또는 버킷에 커스텀 도메인을 연결해도 됩니다.)
# 3) R2 -> "관리 > API 토큰"에서 이 버킷에 대한 읽기/쓰기 API 토큰을 발급받습니다.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="xxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxx"
R2_BUCKET_NAME="class-project-board"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# 웹 푸시 알림 ("새 글 알림 받기") - VAPID 키 한 쌍이 필요합니다.
# `npx web-push generate-vapid-keys`로 생성할 수 있습니다.
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저(클라이언트)에도 노출되는 값입니다 (공개키라 안전).
NEXT_PUBLIC_VAPID_PUBLIC_KEY="xxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxx"
VAPID_SUBJECT="mailto:you@example.com"

# 관리자 페이지 "사용량 대시보드"에서 Neon(데이터베이스) 사용량을 보여주는 데 필요합니다.
# 1) https://console.neon.tech 로그인 -> 우측 상단 프로필 -> Settings -> API keys -> 새 키 생성
# 2) 사용 중인 프로젝트 -> Settings -> General 에서 Project ID 확인 (예: cool-glade-12345678)
NEON_API_KEY="xxxxxxxx"
NEON_PROJECT_ID="xxxxxxxx"

# 관리자 페이지 "사용량 대시보드"에서 Vercel(호스팅) 사용량을 보여주는 데 필요합니다.
# 1) https://vercel.com/account/tokens 에서 새 토큰 발급
# 2) VERCEL_TEAM_ID는 이 프로젝트가 Vercel Team(여러 명이 같이 쓰는 조직) 소속일 때만 필요합니다.
#    개인 계정으로 바로 배포했다면 비워두거나 이 줄을 지워도 됩니다.
VERCEL_API_TOKEN="xxxxxxxx"
VERCEL_TEAM_ID=""
