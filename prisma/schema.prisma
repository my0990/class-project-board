generator client {
  provider = "prisma-client-js"
}

datasource db {
  // 로컬 개발과 배포 모두 Postgres를 사용합니다 (무료 Neon 프로젝트를 하나 더
  // 만들어서 로컬 전용 DATABASE_URL로 쓰는 걸 추천합니다). provider를 굳이
  // 바꿀 필요가 없습니다.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 전체 프로젝트 공통 설정 (딱 1개 row만 존재)
model Config {
  id                   String   @id @default(cuid())
  projectTitle         String
  adminPasswordHash    String
  // 켜져 있을 때만 다음 배포에서 구독자 전체에게 "업데이트 안내" 푸시 알림을 보냅니다.
  // 알림이 나가면(성공/실패 상관없이) 다시 자동으로 꺼집니다 - 매 배포마다 깜빡하고
  // 계속 알림이 나가는 걸 막기 위해서입니다.
  deployNotifyEnabled  Boolean  @default(false)
  // Vercel "Spend Management" 웹훅이 예산의 50%/75%/100%에 도달할 때마다 보내주는
  // 최신 사용량 스냅샷입니다. 아직 한 번도 웹훅을 못 받았으면 전부 null입니다.
  vercelSpendBudgetUsd    Int?
  vercelSpendCurrentUsd   Int?
  vercelSpendThresholdPct Int?
  vercelSpendUpdatedAt    DateTime?
  updatedAt            DateTime @updatedAt
}

// 탐구 단원 (UOI). 예: uoi1, uoi2, uoi3
model Uoi {
  id        String   @id @default(cuid())
  order     Int      @unique
  name      String
  createdAt DateTime @default(now())

  lois Loi[]
}

// 탐구 주제 (LOI). 하나의 UOI 안에 여러 개가 순서대로 존재합니다.
model Loi {
  id        String   @id @default(cuid())
  uoi       Uoi      @relation(fields: [uoiId], references: [id], onDelete: Cascade)
  uoiId     String
  order     Int
  name      String
  createdAt DateTime @default(now())

  stages Stage[]

  @@unique([uoiId, order])
}

// 수업 단계 (예: 관계맺기, 일반화하기). 하나의 LOI 안에 여러 개가 순서대로 존재합니다.
model Stage {
  id        String   @id @default(cuid())
  loi       Loi      @relation(fields: [loiId], references: [id], onDelete: Cascade)
  loiId     String
  order     Int
  name      String
  createdAt DateTime @default(now())

  posts Post[]

  @@unique([loiId, order])
}

// 학급 (7개 학급 = 7개 row)
model ClassRoom {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  teacherName       String?
  passwordHash      String
  createdAt         DateTime @default(now())
  // 이 반에서 새 글을 올리거나 수정할 때, 알림을 받기로 한 사람들에게 푸시 알림을 보낼지 여부.
  // 꺼두면 이 반의 글은 조용히 등록/수정되고 아무에게도 알림이 가지 않습니다.
  pushNotifyEnabled Boolean  @default(true)

  posts Post[]
}

// 학급이 특정 단계에서 등록하는 진행 상황 글
model Post {
  id          String       @id @default(cuid())
  classRoom   ClassRoom    @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  classRoomId String
  stage       Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId     String
  content     String
  createdAt   DateTime     @default(now())

  attachments Attachment[]
}

// 게시글에 첨부된 사진/동영상 (게시글 1개당 여러 개 가능)
model Attachment {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  url       String
  type      String // "image" | "video"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// "새 글 알림 받기"를 누른 브라우저(기기)의 웹 푸시 구독 정보
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
